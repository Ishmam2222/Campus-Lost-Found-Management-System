# Database Connection (Use Supabase PostgreSQL pooler URL in production on Vercel)
DATABASE_URL=sqlite:///./lost_and_found.db

# JWT & Password Security Secrets (Set these in Vercel Environment Variables)
JWT_SECRET=replace-with-a-32-byte-random-hex-secret
PASSWORD_PEPPER=replace-with-a-server-side-password-pepper
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Allowed Frontend Origin for CORS
FRONTEND_ORIGIN=https://campus-lost-found-management-system.vercel.app
